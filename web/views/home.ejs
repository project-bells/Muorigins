<%- include('partials/site_head', { pageTitle, page }) %>
<main class="forge-main">
  <section class="forge-section" id="server-info">
    <div class="container">
      <div class="forge-heading"><span>01 · SERVER CODEX</span><h2>THE REALM, AT A GLANCE</h2><p>Everything that defines the MuOrigins journey—without hidden rules or inflated promises.</p></div>
      <div class="forge-bento">
        <article class="bento-card bento-rate"><div class="bento-icon"><i data-lucide="swords"></i></div><span>EXPERIENCE RATE</span><strong>x100</strong><h3>Classic combat. Faster progression.</h3><p>Advance through the original 0.97K world at a focused pace while every milestone still matters.</p><div class="rate-runes"><b>0.97K</b><b>ENGLISH</b><b>4 CLASSES</b></div></article>
        <article class="bento-card bento-start"><i data-lucide="sparkles"></i><span>NEW HERO REWARD</span><strong>300 POINTS</strong><p>Plus <em>20,000,000 Zen</em> the moment your character begins.</p></article>
        <article class="bento-card"><i data-lucide="rotate-ccw"></i><span>RESET SYSTEM</span><h3>10 MAXIMUM RESETS</h3><p>Level 400 · 1,000,000 Zen per reset.</p></article>
        <article class="bento-card bento-siege"><i data-lucide="castle"></i><span>CASTLE WARFARE</span><h3>FIGHT FOR DOMINION</h3><p>Gather your guild, forge alliances and prepare to claim the realm.</p></article>
        <article class="bento-card"><i data-lucide="skull"></i><span>BOSS HUNTING</span><h3>RARE DROPS AWAIT</h3><p>Excellent item chance 20% with drops up to the Red Dragon tier.</p></article>
      </div>
    </div>
  </section>

  <section class="forge-section forge-realms" id="realms">
    <div class="container">
      <div class="forge-heading"><span>02 · CHOOSE YOUR REALM</span><h2>TWO PATHS. ONE LEGEND.</h2><p>Each room supports up to 60 warriors and shares the same classic world.</p></div>
      <div class="forge-realm-grid">
        <article class="forge-realm realm-war"><div class="realm-index">I</div><div class="realm-copy"><span><b></b> PVP REALM</span><h3>MUORIGINS 1</h3><p>Open player combat outside safe zones. Lost Tower is a special conflict zone: fight freely without gaining murderer status.</p><ul><li><i data-lucide="swords"></i> Open PvP</li><li><i data-lucide="map-pin"></i> PK-free Lost Tower</li><li><i data-lucide="users"></i> 60 player capacity</li></ul></div></article>
        <article class="forge-realm realm-peace"><div class="realm-index">II</div><div class="realm-copy"><span><b></b> NON-PVP REALM</span><h3>ORIGINS</h3><p>Explore, progress and hunt without player combat. Blood Castle and Devil Square remain protected in this room.</p><ul><li><i data-lucide="shield-check"></i> Non-PvP</li><li><i data-lucide="gem"></i> Safe progression</li><li><i data-lucide="users"></i> 60 player capacity</li></ul></div></article>
      </div>
    </div>
  </section>

  <section class="forge-section forge-classes" id="classes">
    <div class="container">
      <div class="forge-heading"><span>03 · HEROES OF THE CONTINENT</span><h2>CHOOSE YOUR DESTINY</h2><p>Four iconic paths, tuned for both PvP encounters and monster hunting.</p></div>
      <div class="class-stage" data-class-stage>
        <div class="class-portrait"><div class="portrait-aura"></div><img data-class-image src="/assets/images/classes/dk.svg" alt="Dark Knight"><span data-class-number>01</span></div>
        <div class="class-details"><span data-class-role>FRONTLINE WARRIOR</span><h3 data-class-name>DARK KNIGHT</h3><p data-class-copy>A relentless melee champion built for close-range pressure, durability and decisive duels.</p><div class="class-traits" data-class-traits><span>MELEE FORCE</span><span>HIGH DEFENSE</span><span>100% PROFILE</span></div><a href="/register"><span data-class-cta>BEGIN AS DARK KNIGHT</span> <i data-lucide="arrow-up-right"></i></a></div>
        <div class="class-tabs" role="tablist" aria-label="Character classes">
          <button class="active" type="button" role="tab" aria-selected="true" data-name="DARK KNIGHT" data-role="FRONTLINE WARRIOR" data-copy="A relentless melee champion built for close-range pressure, durability and decisive duels." data-image="/assets/images/classes/dk.svg" data-number="01" data-traits="MELEE FORCE|HIGH DEFENSE|100% PROFILE"><span>01</span>DARK KNIGHT</button>
          <button type="button" role="tab" aria-selected="false" data-name="DARK WIZARD" data-role="ARCANE CASTER" data-copy="Command the battlefield from range with destructive magic and devastating area attacks." data-image="/assets/images/classes/dw.svg" data-number="02" data-traits="ARCANE POWER|AREA DAMAGE|105% PROFILE"><span>02</span>DARK WIZARD</button>
          <button type="button" role="tab" aria-selected="false" data-name="FAIRY ELF" data-role="RANGED SUPPORT" data-copy="Strike with precision, move with speed and strengthen allies through ancient elven magic." data-image="/assets/images/classes/elf.svg" data-number="03" data-traits="RANGED ATTACK|PARTY SUPPORT|110% PROFILE"><span>03</span>FAIRY ELF</button>
          <button type="button" role="tab" aria-selected="false" data-name="MAGIC GLADIATOR" data-role="HYBRID CHAMPION" data-copy="Blend swordplay and sorcery into a versatile build with seven stat points gained each level." data-image="/assets/images/classes/mg.svg" data-number="04" data-traits="HYBRID BUILD|7 PTS / LEVEL|95% PROFILE"><span>04</span>MAGIC GLADIATOR</button>
        </div>
      </div>
    </div>
  </section>

  <section class="forge-section forge-arsenal">
    <div class="container">
      <div class="forge-heading"><span>04 · FORGE &amp; ECONOMY</span><h2>EARN POWER. TEMPER FATE.</h2><p>Clear progression rules put every upgrade in your hands.</p></div>
      <div class="arsenal-grid"><article><i data-lucide="package-open"></i><span>SHOP</span><h3>BOX +1 / +2 / +3</h3><p>Progression boxes available from in-game shops.</p></article><article><i data-lucide="gem"></i><span>JEWELS</span><h3>BLESS &amp; SOUL</h3><p>Core upgrade jewels available for purchase.</p></article><article><i data-lucide="anvil"></i><span>UPGRADE</span><h3>75% TO +9</h3><p>+7, +8 and +9 at 75%. +10 and +11 at 50%.</p></article><article><i data-lucide="feather"></i><span>WINGS</span><h3>50% / 35%</h3><p>First wings at 50%. Second wings at 35%.</p></article></div>
    </div>
  </section>

  <section class="forge-section forge-commands" id="commands"><div class="container command-layout"><div class="forge-heading"><span>05 · PLAYER COMMANDS</span><h2>POWER AT YOUR FINGERTIPS</h2><p>Use these commands directly in game chat.</p><a class="forge-text-link" href="/download">GET THE CLIENT <i data-lucide="arrow-right"></i></a></div><div class="terminal-frame"><div class="terminal-top"><i></i><i></i><i></i><span>MUORIGINS COMMAND CONSOLE</span></div><div class="terminal-body"><p><code>/str &lt;amount&gt;</code><span>Add Strength</span></p><p><code>/agi &lt;amount&gt;</code><span>Add Agility</span></p><p><code>/vit &lt;amount&gt;</code><span>Add Vitality</span></p><p><code>/ene &lt;amount&gt;</code><span>Add Energy</span></p><p><code>/post &lt;message&gt;</code><span>Broadcast a global message</span></p><p class="reset"><code>/reset</code><span>Level 400 · Max 10 · 1M Zen</span></p></div></div></div></section>

  <section class="forge-section forge-community" id="community"><div class="container"><div class="forge-heading heading-row"><div><span>06 · CHRONICLES</span><h2>NEWS FROM THE REALM</h2></div><a href="/news">VIEW ALL NEWS <i data-lucide="arrow-up-right"></i></a></div><div class="chronicle-grid">
    <% if (!news || news.length === 0) { %><article class="chronicle-empty"><i data-lucide="scroll-text"></i><span>THE CHRONICLES AWAIT</span><h3>A NEW ERA IS ABOUT TO BEGIN</h3><p>Announcements, events and server updates will appear here.</p></article><% } else { %><% news.slice(0, 3).forEach(function(item, idx) { %><article class="chronicle-card <%= idx === 0 ? 'featured' : '' %>"><% if (item.featuredImage) { %><img src="<%= item.featuredImage %>" alt="" loading="lazy"><% } %><div><span>NEWS · <%= new Date(item.created_at).toLocaleDateString(locale) %></span><% if (!item.hide_title) { %><h3><%= item.title %></h3><% } %><% if (item.excerpt) { %><p><%= item.excerpt %></p><% } %><a href="/news/<%= item.id %>">READ CHRONICLE <i data-lucide="arrow-right"></i></a></div></article><% }); %><% } %>
  </div></div></section>

  <section class="forge-final"><div class="forge-final-glow"></div><div class="container"><img src="/assets/images/muorigins-mark.svg" alt=""><span>THE GATES ARE OPEN</span><h2>YOUR LEGEND<br>BEGINS NOW</h2><p>Version 0.97K · x100 EXP · English client · Two realms</p><div><a class="forge-btn forge-btn-primary" href="/register"><i data-lucide="shield-plus"></i><span>CREATE ACCOUNT<small>Free to play</small></span></a><a class="forge-btn forge-btn-ghost" href="/download"><i data-lucide="download"></i><span>DOWNLOAD<small>English client</small></span></a></div></div></section>
</main>
<%- include('partials/site_footer') %>
