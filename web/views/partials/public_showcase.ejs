<% if (page === 'home') { %>
<section class="forge-hero" aria-labelledby="hero-title">
  <div class="forge-vignette"></div><div class="forge-grain"></div><div class="forge-embers" aria-hidden="true"></div>
  <div class="container forge-hero-inner">
    <div class="forge-hero-copy">
      <div class="forge-badge"><span>✦</span> CLASSIC 0.97K · TWO REALMS ONLINE <span>✦</span></div>
      <p class="forge-overline">A CLASSIC WORLD REFORGED</p>
      <h1 id="hero-title">AWAKEN THE<br><span>FORBIDDEN POWER</span></h1>
      <p class="forge-lede">Return to an uncompromising MU adventure: four iconic classes, x1000 experience, focused progression and a realm built for both warriors and explorers.</p>
      <div class="forge-actions">
        <a class="forge-btn forge-btn-online" href="https://playonline-staging.muorigins.online/" target="_blank" rel="noopener noreferrer"><i data-lucide="monitor-play"></i><span>PLAY ONLINE<small>Launch instantly in your browser</small></span></a>
        <a class="forge-btn forge-btn-primary" href="/download"><i data-lucide="download"></i><span>DOWNLOAD CLIENT<small>English · Version 0.97K</small></span></a>
        <a class="forge-btn forge-btn-ghost" href="/register"><i data-lucide="shield-plus"></i><span>CREATE ACCOUNT<small>Begin your legend</small></span></a>
      </div>
    </div>
    <div class="forge-sigil-wrap" aria-hidden="true">
      <div class="forge-sigil-halo"></div><img src="/assets/images/muorigins-mark.svg" class="forge-sigil" alt="">
      <div class="forge-sigil-caption"><span>MU</span><strong>ORIGINS</strong><small>THE ORIGINAL ADVENTURE RETURNS</small></div>
    </div>
  </div>
  <div class="container forge-stats" aria-label="Server quick statistics">
    <div><span class="online-pulse"></span><small>SERVER STATUS</small><strong>ONLINE</strong></div>
    <div><i data-lucide="users"></i><small>PLAYERS ONLINE</small><strong id="players-online"><%= playersOnline %></strong></div>
    <div><i data-lucide="swords"></i><small>GAME VERSION</small><strong>0.97K</strong></div>
    <div><i data-lucide="zap"></i><small>EXPERIENCE</small><strong>x1000</strong></div>
    <div><i data-lucide="clock-3"></i><small>SERVER TIME · UTC+7</small><strong id="server-time" data-tz="<%= timeZone || 'Asia/Bangkok' %>"><%= serverTime %></strong></div>
  </div>
</section>
<% } else if (siteSettings.theme !== 'classic') { %>
<div class="container mt-5 home-showcase"><%- include('theme_hero') %></div>
<% } %>
