<% if (siteSettings.theme !== "classic" || page === "home") { %>
<div class="container mt-5 <%= siteSettings.theme !== 'classic' ? 'home-showcase' : '' %> <%= page === 'home' ? 'mu-hero' : '' %>">
    <%- include('theme_hero') %>
    <% if (page === 'home') { %>
    <div class="row align-items-end hero-content">
      <div class="col-12 col-lg-7">
        <p class="hero-kicker">THE ORIGINAL ADVENTURE RETURNS</p>
        <h1>MuOrigins <span>0.97K x100</span></h1>
        <p class="hero-copy">Four classic classes, two distinct realms and focused progression. Begin with 300 points and 20 million Zen.</p>
        <div class="d-flex flex-wrap gap-3 hero-actions">
          <a class="btn btn-primary btn-lg" href="/register">Create account</a>
          <a class="btn btn-outline-light btn-lg" href="/download">Download client</a>
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <div class="server-status-card">
          <div class="status-heading"><span class="status-dot"></span><span>SERVER ONLINE</span><strong>Muorigins</strong></div>
          <div class="status-grid">
            <div><small>Players online</small><strong id="players-online"><%= playersOnline %></strong></div>
            <div><small>Version / EXP</small><strong>0.97K · x100</strong></div>
            <div><small>Server time</small><strong id="server-time" data-tz="<%= timeZone || '' %>"><%= serverTime %></strong></div>
            <div><small>Your time</small><strong id="user-time">--:--:--</strong></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
<% } %>
