<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Muorigins — classic MU Online 0.97K. Create an account, download the client, follow events and compete in the rankings.">
  <meta name="theme-color" content="#120d0a">
  <meta name="author" content="Muorigins.online">
  <title><%= pageTitle || appName %></title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>tailwind = { config: { corePlugins: { preflight: false }, theme: { extend: { fontFamily: { display: ['Cinzel', 'serif'], body: ['Rajdhani', 'sans-serif'] } } } } };</script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/custom.css?v=20261017-realm-guide">
  <% if (page === 'home') { %><link rel="stylesheet" href="/assets/css/forge.css?v=20261017-forge"><% } %>
  <script src="/js/i18n.js"></script>
  <script src="/locales/en.js"></script>
  <% if (siteSettings.theme !== "classic") { %><link rel="stylesheet" href="/css/daedalus.css?v=20261017-muorigins"><% } %>
</head>
<body class="d-flex flex-column theme-<%= siteSettings.theme %> <%= page === 'home' ? 'forge-home' : '' %>">
  <nav class="top-navbar">
    <div class="container d-flex flex-wrap align-items-center">
      <a class="navbar-brand text-white fw-bold me-auto brand-lockup" href="/" aria-label="Muorigins home">
        <img class="brand-emblem" src="/assets/images/muorigins-mark.svg" alt=""><span><%= appName %><small>Classic 0.97K</small></span>
      </a>

      <button class="navbar-toggler border-0 d-block d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-expanded="false" aria-label="<%= t("Menu") %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" class="bi" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M2.5 11.5A.5.5 0 0 1 3 11h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4A.5.5 0 0 1 3 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"></path>
        </svg>
      </button>

      <div class="nav d-none d-lg-flex align-items-center">
        <% if (session && session.user) { %>
          <a class="nav-link text-white" href="/account">Account</a>
          <a class="nav-link text-white" href="/logout">Log out</a>
        <% } else { %>
          <a class="nav-link text-white" href="/login">Login / Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <header class="navbar navbar-expand-lg transparent-header p-3 mb-3 d-none d-lg-block">
    <div class="container">
      <div class="collapse navbar-collapse justify-content-center" id="mainNav">
        <ul class="navbar-nav mb-2 mb-lg-0">
          <li class="nav-item"><a href="/" class="nav-link text-white <%= page === 'home' ? 'active' : '' %>">Home</a></li>
          <li class="nav-item"><a href="/#server-info" class="nav-link text-white">Server Info</a></li>
          <li class="nav-item"><a href="/rankings" class="nav-link text-white <%= page === 'rankings' ? 'active' : '' %>">Rankings</a></li>
          <li class="nav-item"><a href="/download" class="nav-link text-white <%= page === 'download' ? 'active' : '' %>">Downloads</a></li>
          <li class="nav-item"><a href="https://playonline-staging.muorigins.online/" target="_blank" rel="noopener noreferrer" class="nav-link text-white"><i data-lucide="monitor-play" aria-hidden="true"></i> Play Online</a></li>
          <li class="nav-item"><a href="/#community" class="nav-link text-white">Community</a></li>
        </ul>
      </div>
    </div>
  </header>

  <div class="offcanvas offcanvas-start w-100" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
    <div class="offcanvas-header border-bottom">
      <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menu</h5>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
      <ul class="navbar-nav">
        <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="/#server-info" class="nav-link">Server Info</a></li>
        <li class="nav-item"><a href="/rankings" class="nav-link">Rankings</a></li>
        <li class="nav-item"><a href="/download" class="nav-link">Downloads</a></li>
        <li class="nav-item"><a href="https://playonline-staging.muorigins.online/" target="_blank" rel="noopener noreferrer" class="nav-link"><i data-lucide="monitor-play" aria-hidden="true"></i> Play Online</a></li>
        <li class="nav-item"><a href="/#community" class="nav-link">Community</a></li>
      </ul>

      <div class="mt-3">
        <% if (session && session.user) { %>
          <a class="btn btn-outline-dark w-100 mb-2" href="/account">Account</a>
          <a class="btn btn-outline-secondary w-100" href="/logout">Log out</a>
        <% } else { %>
          <a class="btn btn-primary w-100 mb-2" href="/login">Log in</a>
          <a class="btn btn-outline-primary w-100" href="/register">Create account</a>
        <% } %>
      </div>
    </div>
  </div>

<%- include('public_showcase') %>
